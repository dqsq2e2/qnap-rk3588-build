Subject: [PATCH 3/4] add fan1_input temp1_input for qnap

---
 drivers/hwmon/Makefile  |   1 +
 drivers/hwmon/pwm-fan.c | 153 +++++++++++++++++++++++++++++++++++++---
 2 files changed, 146 insertions(+), 8 deletions(-)

diff --git a/drivers/hwmon/Makefile b/drivers/hwmon/Makefile
index cb8a74d80..4049550c8 100644
--- a/drivers/hwmon/Makefile
+++ b/drivers/hwmon/Makefile
@@ -155,6 +155,7 @@ obj-$(CONFIG_SENSORS_PC87360)	+= pc87360.o
 obj-$(CONFIG_SENSORS_PC87427)	+= pc87427.o
 obj-$(CONFIG_SENSORS_PCF8591)	+= pcf8591.o
 obj-$(CONFIG_SENSORS_POWR1220)  += powr1220.o
+ccflags-y += -DCONFIG_PWM_FAN_SIMULATED_RPM
 obj-$(CONFIG_SENSORS_PWM_FAN)	+= pwm-fan.o
 obj-$(CONFIG_SENSORS_RASPBERRYPI_HWMON)	+= raspberrypi-hwmon.o
 obj-$(CONFIG_SENSORS_S3C)	+= s3c-hwmon.o
diff --git a/drivers/hwmon/pwm-fan.c b/drivers/hwmon/pwm-fan.c
index ec171f2b6..b635e7aeb 100644
--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -19,9 +19,45 @@
 #include <linux/sysfs.h>
 #include <linux/thermal.h>
 #include <linux/timer.h>
+#include <linux/moduleparam.h>
 
 #define MAX_PWM 255
 
+static char *thermal_zone = "soc-thermal";
+module_param(thermal_zone, charp, 0444);
+MODULE_PARM_DESC(thermal_zone, "Thermal zone name (default: soc-thermal)");
+
+#ifdef CONFIG_PWM_FAN_SIMULATED_RPM
+/* 模拟测速 start */
+static unsigned int max_rpm = 5000;
+
+static int param_set_max_rpm(const char *val, const struct kernel_param *kp)
+{
+    int ret;
+    unsigned int new_rpm;
+
+    ret = kstrtouint(val, 10, &new_rpm);
+    if (ret < 0)
+        return ret;
+
+    if (new_rpm < 1000) {
+        pr_err("max_rpm cannot be less than 1000\n");
+        return -EINVAL;
+    }
+
+    return param_set_uint(val, kp);
+}
+
+static const struct kernel_param_ops param_ops_max_rpm = {
+    .set = param_set_max_rpm,
+    .get = param_get_uint,
+};
+
+module_param_cb(max_rpm, &param_ops_max_rpm, &max_rpm, 0644);
+MODULE_PARM_DESC(max_rpm, "Maximum simulated RPM (min: 1000, default: 5000)");
+/* 模拟测速 end */
+#endif // CONFIG_PWM_FAN_SIMULATED_RPM
+
 struct pwm_fan_ctx {
 	struct mutex lock;
 	struct pwm_device *pwm;
@@ -133,28 +169,101 @@ static ssize_t rpm_show(struct device *dev,
 			struct device_attribute *attr, char *buf)
 {
 	struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
-
+#ifdef CONFIG_PWM_FAN_SIMULATED_RPM
+	unsigned int simulated_rpm = (max_rpm * ctx->pwm_value) / MAX_PWM;
+	return sprintf(buf, "%u\n", simulated_rpm);
+#else
 	return sprintf(buf, "%u\n", ctx->rpm);
+#endif // CONFIG_PWM_FAN_SIMULATED_RPM
 }
 
 static SENSOR_DEVICE_ATTR_RW(pwm1, pwm, 0);
 static SENSOR_DEVICE_ATTR_RO(fan1_input, rpm, 0);
 
+static int32_t fan_pwm1_enable = 1;
+static ssize_t show_pwm1_enable(struct device *dev,
+				struct device_attribute *attr,
+				char *buf)
+{
+	sprintf(buf, "%d\n", fan_pwm1_enable);
+	return sprintf(buf, "%d\n", fan_pwm1_enable);
+}
+
+static ssize_t store_pwm1_enable(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
+	int ret;
+
+	ret = kstrtoint(buf, 10, &fan_pwm1_enable);
+	if (ret < 0 || (fan_pwm1_enable != 0 && fan_pwm1_enable != 1))
+		return -EINVAL;
+
+	if (fan_pwm1_enable)
+	{
+		__set_pwm(ctx, ctx->pwm_value);
+	} else {
+		__set_pwm(ctx, 0);
+	}
+	return count;
+}
+
+static SENSOR_DEVICE_ATTR(pwm1_enable, 0644, show_pwm1_enable, store_pwm1_enable, 0);
+
+
+
+static ssize_t show_temp1_input(struct device *dev,
+                                struct device_attribute *attr,
+                                char *buf)
+{
+    struct thermal_zone_device *tz;
+    int temp, ret;
+
+    tz = thermal_zone_get_zone_by_name(thermal_zone);
+    if (IS_ERR(tz)) {
+        dev_err(dev, "Thermal zone '%s' not found\n", thermal_zone);
+        return sprintf(buf, "0\n");
+    }
+
+    ret = thermal_zone_get_temp(tz, &temp);
+    if (ret) {
+        dev_err(dev, "Failed to read temperature\n");
+        return sprintf(buf, "0\n");
+    }
+
+    return sprintf(buf, "%d\n", temp);
+}
+
+static ssize_t show_temp1_label(struct device *dev,
+                                struct device_attribute *attr,
+                                char *buf)
+{
+    return sprintf(buf, "SYSTIN\n");
+}
+
+static SENSOR_DEVICE_ATTR(temp1_input, 0644, show_temp1_input, NULL, 0);
+static SENSOR_DEVICE_ATTR(temp1_label, 0644, show_temp1_label, NULL, 0);
+
+
 static struct attribute *pwm_fan_attrs[] = {
 	&sensor_dev_attr_pwm1.dev_attr.attr,
 	&sensor_dev_attr_fan1_input.dev_attr.attr,
+    &sensor_dev_attr_pwm1_enable.dev_attr.attr,
+    &sensor_dev_attr_temp1_input.dev_attr.attr,
+    &sensor_dev_attr_temp1_label.dev_attr.attr,
 	NULL,
 };
 
 static umode_t pwm_fan_attrs_visible(struct kobject *kobj, struct attribute *a,
 				     int n)
 {
-	struct device *dev = container_of(kobj, struct device, kobj);
-	struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
+	//struct device *dev = container_of(kobj, struct device, kobj);
+	//struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
 
 	/* Hide fan_input in case no interrupt is available  */
-	if (n == 1 && ctx->irq <= 0)
-		return 0;
+/* 	if (n == 1 && ctx->irq <= 0)
+		return 0; */
 
 	return a->mode;
 }
@@ -164,10 +273,13 @@ static const struct attribute_group pwm_fan_group = {
 	.is_visible = pwm_fan_attrs_visible,
 };
 
+
+/*
 static const struct attribute_group *pwm_fan_groups[] = {
 	&pwm_fan_group,
 	NULL,
 };
+*/
 
 /* thermal cooling device callbacks */
 static int pwm_fan_get_max_state(struct thermal_cooling_device *cdev,
@@ -367,13 +479,21 @@ static int pwm_fan_probe(struct platform_device *pdev)
 		mod_timer(&ctx->rpm_timer, jiffies + HZ);
 	}
 
-	hwmon = devm_hwmon_device_register_with_groups(dev, "pwmfan",
-						       ctx, pwm_fan_groups);
+	//hwmon = devm_hwmon_device_register_with_groups(dev, "pwmfan",
+	//					       ctx, pwm_fan_groups);
+	hwmon = devm_hwmon_device_register_with_groups(dev, "pwmfan", ctx, NULL);
 	if (IS_ERR(hwmon)) {
 		dev_err(dev, "Failed to register hwmon device\n");
 		return PTR_ERR(hwmon);
 	}
 
+   // 手动创建 sysfs 组
+    ret = sysfs_create_group(&dev->kobj, &pwm_fan_group);
+    if (ret) {
+        dev_err(dev, "Failed to create pwm_fan attributes: %d\n", ret);
+        return ret;
+    }
+
 	ret = pwm_fan_of_get_cooling_data(dev, ctx);
 	if (ret)
 		return ret;
@@ -423,9 +543,25 @@ static int pwm_fan_disable(struct device *dev)
 	return 0;
 }
 
+static void pwm_fan_cleanup(struct device *dev)
+{
+    // 移除 sysfs 组
+    sysfs_remove_group(&dev->kobj, &pwm_fan_group);
+
+    // 关闭 PWM 和电源（原有逻辑）
+    pwm_fan_disable(dev);
+}
+
+static int pwm_fan_remove(struct platform_device *pdev)
+{
+    pwm_fan_cleanup(&pdev->dev);
+    return 0;
+}
+
 static void pwm_fan_shutdown(struct platform_device *pdev)
 {
-	pwm_fan_disable(&pdev->dev);
+	//pwm_fan_disable(&pdev->dev);
+	pwm_fan_cleanup(&pdev->dev);
 }
 
 #ifdef CONFIG_PM_SLEEP
@@ -471,6 +607,7 @@ MODULE_DEVICE_TABLE(of, of_pwm_fan_match);
 
 static struct platform_driver pwm_fan_driver = {
 	.probe		= pwm_fan_probe,
+	.remove     = pwm_fan_remove,  // 新增 remove 函数
 	.shutdown	= pwm_fan_shutdown,
 	.driver	= {
 		.name		= "pwm-fan",
