#!/bin/sh

# G98 网口命名规整（须在 QTS/hal 扫描网口之前执行）：
#   RTL8125 2.5G x2 (r8169)  -> eth0/eth1（按 PCI 地址：0002:21 在前、0003:31 在后）
#   YT9215 DSA 用户口 lan1-8 -> eth2..eth9
#   gmac CPU 口              -> dsa0/dsa1 并保持 UP
#     （QTS 只认 eth* 命名会自动忽略 CPU 口；但 DSA master 必须 UP 用户口才能通）

# 库存预编译无线/网卡模块与自编译内核 ABI 不兼容：一旦被 modprobe/insmod 加载
# 即在 register_netdevice_notifier 路径 oops，死进程持 RTNL 锁 → 全局网络死锁
# （sshd 卡 banner、ip addr 挂 D 态、网络与虚拟交换机服务全灭、qpkg 启动超时）。
# 改名 .disabled 无效：QTS 启动时 depmod 会把 .ko.disabled 重新索引为可加载模块，
# 必须每次启动彻底删除并重建 dep 索引。
g98_purge_stock_modules()
{
	local m
	for m in cfg80211.ko mac80211.ko ath.ko ath9k.ko ath9k_common.ko ath9k_hw.ko ath9k_htc.ko ath10k_core.ko ath10k_pci.ko ath10k_snoc.ko iwlwifi.ko iwlmvm.ko iwldvm.ko mt76.ko mt76-usb.ko mt7601u.ko mt76x0-common.ko mt76x02-lib.ko mt76x02-usb.ko mt76x0u.ko r8125.ko; do
		rm -f /lib/modules/5.10.60-qnap/$m /lib/modules/5.10.60-qnap/$m.disabled /usr/local/modules/$m /usr/local/modules/$m.disabled 2>/dev/null
	done
	rm -f /lib/modules/5.10.60-qnap/wifi/*.ko 2>/dev/null
	# 清掉 dep 文本索引里指向已删模块（含 .disabled）的条目，再重建
	sed -i '/\.ko\.disabled/d' /lib/modules/5.10.60-qnap/modules.dep /lib/modules/5.10.60-qnap/modules.alias /lib/modules/5.10.60-qnap/modules.symbols 2>/dev/null
	command -v depmod >/dev/null 2>&1 && depmod -a 2>/dev/null
	echo G98MARK:purge-stock-modules-done > /dev/kmsg
}

g98_rename_nics()
{
	command -v ip >/dev/null 2>&1 || return 0
	local ifc path target i
	# 1) gmac CPU 口改名让位（fe1b0000=gmac0 -> dsa0，fe1c0000=gmac1 -> dsa1）
	for ifc in $(ls /sys/class/net/ 2>/dev/null); do
		path=$(readlink /sys/class/net/$ifc/device 2>/dev/null)
		case "$path" in
		*fe1b0000.ethernet*) target=dsa0 ;;
		*fe1c0000.ethernet*) target=dsa1 ;;
		*) continue ;;
		esac
		if [ "$ifc" != "$target" ]; then
			ifconfig $ifc down 2>/dev/null
			ip link set dev $ifc name $target 2>/dev/null
			echo G98MARK:rename-$ifc-to-$target > /dev/kmsg
		fi
		ifconfig $target up 2>/dev/null
	done
	# 2) RTL8125 -> eth0/eth1
	for ifc in $(ls /sys/class/net/ 2>/dev/null); do
		path=$(readlink /sys/class/net/$ifc/device 2>/dev/null)
		case "$path" in
		*0002:21:00.0*) target=eth0 ;;
		*0003:31:00.0*) target=eth1 ;;
		*) continue ;;
		esac
		if [ "$ifc" != "$target" ]; then
			ifconfig $ifc down 2>/dev/null
			ip link set dev $ifc name $target 2>/dev/null
			echo G98MARK:rename-$ifc-to-$target > /dev/kmsg
		fi
	done
	# 3) DSA 用户口 lan1-8 -> eth2-eth9
	i=1
	while [ $i -le 8 ]; do
		if [ -d /sys/class/net/lan$i ] && [ ! -d /sys/class/net/eth$((i+1)) ]; then
			ifconfig lan$i down 2>/dev/null
			ip link set dev lan$i name eth$((i+1)) 2>/dev/null
			echo G98MARK:rename-lan$i-to-eth$((i+1)) > /dev/kmsg
		fi
		i=$((i+1))
	done
	# 4) DSA master 必须保持 UP
	ifconfig dsa0 up 2>/dev/null
	ifconfig dsa1 up 2>/dev/null
	echo G98MARK:rename-done > /dev/kmsg
}

patch_front()
{
	[ ! -f /lib/modules/5.10.60-qnap/ledtrig-heartbeat.ko ] || /sbin/insmod /lib/modules/5.10.60-qnap/ledtrig-heartbeat.ko 2>>/dev/null
	g98_purge_stock_modules
	# YT921x DSA 三件套已内置化（CONFIG_NET_DSA/NET_DSA_YT921X/NET_DSA_TAG_YT921X=y），
	# 内核启动即 probe，无需在此 insmod
	g98_rename_nics
	sed "/i915.ko/i \[ ! -f /lib/modules/misc/gpu-sched.ko \] || /sbin/insmod /lib/modules/misc/gpu-sched.ko" /etc/init.d/init_check.sh -i
	sed "/i915.ko/i \[ ! -f /lib/modules/misc/panfrost.ko \] || /sbin/insmod /lib/modules/misc/panfrost.ko" /etc/init.d/init_check.sh -i
	sed "/hal_netlink.ko/i if \[ x$(fw_printenv -n qnap_kernel) != x"qnap" \] && [ $(fw_printenv -n qnap_kernel_version) -lt 521 ]; then cp -f /lib/modules/misc/hal_netlink.bak /lib/modules/misc/hal_netlink.ko ; fi" /etc/init.d/init_check.sh -i
	#echo schedutil | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
	if [ x$(fw_printenv -n qnap_kernel) = x"qnap" ]; then /sbin/insmod /lib/modules/misc/pwm-fan.ko; sed '/^SIO_HWMON_INDEX[[:space:]]*=/c\SIO_HWMON_INDEX = 7'  -i  /etc/model.conf; fi 2>>/dev/null
	#fix model MEMORY_SIZE_M
	Total=$(cat /proc/meminfo |grep 'MemTotal' |awk -F : '{print $2}' |sed 's/^[ \t]*//g' | cut -d " " -f1)
	if [ $((Total % 1024 % 1024)) -eq 0 ]; then let Total=Total/1024 ;else let Total=(Total/1024/1024+1)*1024; fi
	sed "/MEMORY_SIZE_M/c\MEMORY_SIZE_M = $Total" -i /etc/model.conf	
	#fix mali firmware
	mali_csffw_file=$(dmesg | grep mali | grep DDK | awk '(NR==1){print $0}' | awk -F' ' '{print $NF}' | cut -d - -f1)
	ln -sf /lib/firmware/mali_csffw_${mali_csffw_file}/mali_csffw.bin /lib/firmware/mali_csffw.bin
}

patch_back()
{
	sed -i 's/^\([[:space:]]*\)if \[ -f \/tmp\/update_img.sh \]; then$/\1\/sbin\/qnap_patch -p\n&/' /etc/init.d/update.sh
}

while getopts ":fb" opt; do
  case $opt in
    f)
	  #初始化boot前
      patch_front
      ;;
    b)
      #boot后加载
	  patch_back
      ;;  
    \?)
      echo "Invalid option: -$OPTARG" 
      ;;
  esac
done
exit 0
