+	memset(pmlmepriv->ext_capab_ie_data, 0, sizeof(pmlmepriv->ext_capab_ie_data));
+	pmlmepriv->ext_capab_ie_len = 0;
+
+#ifdef CONFIG_CONCURRENT_MODE
+	adapt->securitypriv.dot118021x_bmc_cam_id = INVALID_SEC_MAC_CAM_ID;
