+	} else if (p_dm->support_ic_type & ODM_IC_11N_SERIES) {
+		odm_set_bb_reg(p_dm, ODM_REG_CLM_11N, BIT(0), 0x0);	/*Trigger CLM*/
+		odm_set_bb_reg(p_dm, ODM_REG_CLM_11N, BIT(0), 0x1);
+	}
+}
