+
+	piopriv->adapt = adapt;
+	pintf->adapt = adapt;
+	pintf->pintf_dev = adapter_to_dvobj(adapt);
+
+	set_intf_ops(adapt, &pintf->io_ops);
+
+	return _SUCCESS;
