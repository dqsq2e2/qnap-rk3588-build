+void
+phydm_nhm_trigger(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm = (struct PHY_DM_STRUCT *)p_dm_void;
+
+	PHYDM_DBG(p_dm, DBG_ENV_MNTR, ("[%s]===>\n", __func__));
+
+	if (p_dm->support_ic_type & ODM_IC_11AC_SERIES) {
+
