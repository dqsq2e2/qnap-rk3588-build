+void rtw_hal_update_iqk_fw_offload_cap(struct adapter *adapter)
+{
+	struct hal_com_data * hal = GET_HAL_DATA(adapter);
+	struct PHY_DM_STRUCT *p_dm_odm = adapter_to_phydm(adapter);
