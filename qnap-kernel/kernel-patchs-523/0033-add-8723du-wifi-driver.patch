+	for (i = 0; i < dvobj->iface_nums; i++) {
+		if (get_hw_port(dvobj->adapters[i]) == HW_PORT0)
+			break;
+	}
+
+	if (i < 0 || i >= dvobj->iface_nums)
+		rtw_warn_on(1);
+	else
