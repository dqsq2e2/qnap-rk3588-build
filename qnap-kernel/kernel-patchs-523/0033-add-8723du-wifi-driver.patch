+void
+PHY_GetRateValuesOfTxPowerByRate(
+	struct adapter * pAdapter,
+	u32 RegAddr,
+	u32 BitMask,
+	u32 Value,
+	u8 *Rate,
+	s8 *PwrByRateVal,
+	u8 *RateNum
