+		if (wrqu->data.flags == 0)
+			intel_widi_wk_cmd(adapt, INTEL_WIDI_ISSUE_PROB_WK, pbuf, sizeof(l2_msg_t));
+		else if (wrqu->data.flags == 1)
+			rtw_set_wfd_rds_sink_info(adapt, (l2_msg_t *)pbuf);
+	}
+	return ret;
