+
+	pdvobjpriv = adapter_to_dvobj(adapt);
+	tx_amsdu = adapt->tx_amsdu;
+	tx_amsdu_rate = adapt->tx_amsdu_rate;
+	current_tx_rate = pdvobjpriv->traffic_stat.cur_tx_tp;
