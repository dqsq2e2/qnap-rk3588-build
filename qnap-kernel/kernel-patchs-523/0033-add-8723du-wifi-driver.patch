+int WMM_param_handler(struct adapter *adapt, struct ndis_802_11_variable_ies *	pIE)
+{
+	/* struct registry_priv	*pregpriv = &adapt->registrypriv; */
+	struct mlme_priv	*pmlmepriv = &(adapt->mlmepriv);
