+	struct _CCX_INFO		*ccx_info = &p_dm->dm_ccx_info;
+
+	if (ccx_info->clm_mntr_mode != mode) {
+		ccx_info->clm_mntr_mode = mode;
+		phydm_clm_hw_restart(p_dm);
+
+		if (mode == CLM_DRIVER_MNTR) {
+			phydm_clm_h2c(p_dm,0, 0);
+		}
+	}
+}
