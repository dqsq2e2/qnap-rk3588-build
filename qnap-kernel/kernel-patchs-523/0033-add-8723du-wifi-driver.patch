+void update_monitor_frame_attrib(struct adapter *adapt, struct pkt_attrib *pattrib)
+{
+	u8	wireless_mode;
+	struct mlme_ext_priv	*pmlmeext = &(adapt->mlmeextpriv);
+	struct xmit_priv		*pxmitpriv = &adapt->xmitpriv;
+	struct sta_info		*psta = NULL;
