+static inline u8 hw_var_rcr_config(struct adapter *adapter, u32 rcr)
+{
+	int err;
+
+	err = rtw_write32(adapter, REG_RCR, rcr);
+	if (err == _SUCCESS)
+		GET_HAL_DATA(adapter)->ReceiveConfig = rcr;
