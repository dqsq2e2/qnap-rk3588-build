+	u16 mapLen;
+
+	EFUSE_GetEfuseDefinition(adapt, EFUSE_WIFI, TYPE_EFUSE_MAP_LEN,
+				 (void *)&mapLen, false);
+	ret = rtw_efuse_map_read(adapt, addr, cnts , data);
+
+	rtw_mask_map_read(adapt, addr, cnts , data);
+
+	return ret;
