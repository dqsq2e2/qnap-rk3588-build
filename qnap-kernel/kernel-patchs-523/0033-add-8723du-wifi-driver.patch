+static u64
+phydm_supportability_init_ce(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm = (struct PHY_DM_STRUCT *)p_dm_void;
+	u64			support_ability = 0;
+
+	switch (p_dm->support_ic_type) {
+
+	/*---------------N Series--------------------*/
+	case	ODM_RTL8723D:
+		support_ability |=
+			ODM_BB_DIG				|
+			ODM_BB_RA_MASK			|
+			/*ODM_BB_DYNAMIC_TXPWR	|*/
+			ODM_BB_FA_CNT			|
+			ODM_BB_RSSI_MONITOR		|
+			ODM_BB_CCK_PD			|
+			/* ODM_BB_PWR_TRAIN	| */	
+			ODM_BB_RATE_ADAPTIVE	|
+			ODM_BB_CFO_TRACKING		|
+			ODM_BB_ENV_MONITOR;
+		break;
+	default:
+		support_ability |=
+			ODM_BB_DIG				|
+			ODM_BB_RA_MASK			|
+			/*ODM_BB_DYNAMIC_TXPWR	|*/
+			ODM_BB_FA_CNT			|
+			ODM_BB_RSSI_MONITOR		|
+			ODM_BB_CCK_PD			|
+			/*ODM_BB_PWR_TRAIN		|*/
+			ODM_BB_RATE_ADAPTIVE	|
+			ODM_BB_CFO_TRACKING		|
+			ODM_BB_ENV_MONITOR;
+
+			dbg_print("[Warning] Supportability Init Warning !!!\n");
+		break;
+
+	}
+	
+	/*[Config Antenna Diveristy]*/
+	if (*(p_dm->p_enable_antdiv))
+		support_ability |= ODM_BB_ANT_DIV;
+	
+	/*[Config Adaptivity]*/
+	if (*(p_dm->p_enable_adaptivity))
+		support_ability |= ODM_BB_ADAPTIVITY;
+	
+	return support_ability;
+}
