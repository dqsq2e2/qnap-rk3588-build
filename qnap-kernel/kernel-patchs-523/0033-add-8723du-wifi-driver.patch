+static inline int translate_percentage_to_dbm(u32 SignalStrengthIndex)
+{
+	int	SignalPower; /* in dBm. */
+
+	/* Translate to dBm (x=y-100) */
+	SignalPower = SignalStrengthIndex - 100;
+
+	return SignalPower;
+}
