+	u8		rx_mimo_signal_strength[4];	/* RSSI in 0~100 index */
+	s8		rx_mimo_signal_quality[4];		/* OFDM: per-path's EVM translate to 0~100% , no used for CCK*/
+	u8		rx_mimo_evm_dbm[4];			/* per-path's original EVM (dbm) */
