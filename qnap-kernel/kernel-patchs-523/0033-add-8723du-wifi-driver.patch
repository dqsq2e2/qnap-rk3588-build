+
+		for (i = 0 ; i < retry_count ; i++) {
+			path_s0_ok = phy_path_s0_iqk_8723d(p_dm);
+			if (path_s0_ok == 0x01) {
+				ODM_RT_TRACE(p_dm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("path S0 Tx IQK Success!!\n"));
+				result[t][4] = (odm_get_bb_reg(p_dm, 0xe94, MASKDWORD) & 0x3FF0000) >> 16;
