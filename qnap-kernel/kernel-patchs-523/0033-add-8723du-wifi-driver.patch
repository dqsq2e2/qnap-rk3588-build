+	/* Init Fw LPS related. */
+	adapter_to_pwrctl(adapt)->bFwCurrentInPSMode = false;
+
+	/* Init H2C cmd. */
+	rtw_write8(adapt, REG_HMETFR, 0x0f);
+
+	/* Init H2C counter. by tynli. 2009.12.09. */
