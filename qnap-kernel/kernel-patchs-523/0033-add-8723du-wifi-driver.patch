+#endif
+	d->scan_num += a->scan_num;
+	d->scan_enter_num += a->scan_enter_num;
+	d->uwps_num += a->uwps_num;
+	d->roch_num += a->roch_num;
+	d->mgmt_tx_num += a->mgmt_tx_num;
+}
