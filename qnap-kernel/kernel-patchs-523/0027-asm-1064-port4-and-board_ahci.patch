From 75a4466aa3f84a58232088372dc8519de9ef2dc4 Mon Sep 17 00:00:00 2001
From: R-mt <wxzmz@163.com>
Date: Wed, 20 Aug 2025 14:52:42 +0800
Subject: [PATCH] asm-1064 port4 and board_ahci

---
 drivers/ata/ahci.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/drivers/ata/ahci.c b/drivers/ata/ahci.c
index 331e04765..91bf0fb04 100755
--- a/drivers/ata/ahci.c
+++ b/drivers/ata/ahci.c
@@ -628,6 +628,7 @@ static const struct pci_device_id ahci_pci_tbl[] = {
 #endif
 	{ PCI_VDEVICE(ASMEDIA, 0x0621), board_ahci },   /* ASM1061R */
 	{ PCI_VDEVICE(ASMEDIA, 0x0622), board_ahci },   /* ASM1062R */
+	{ PCI_VDEVICE(ASMEDIA, 0x1064), board_ahci },   /* ASM1064R */
 
 	/*
 	 * Samsung SSDs found on some macbooks.  NCQ times out if MSI is
@@ -681,6 +682,16 @@ MODULE_PARM_DESC(mobile_lpm_policy, "Default LPM policy for mobile chipsets");
 static void ahci_pci_save_initial_config(struct pci_dev *pdev,
 					 struct ahci_host_priv *hpriv)
 {
+	if (pdev->vendor == PCI_VENDOR_ID_ASMEDIA) {
+		if (pdev->device == 0x1166) {
+			dev_info(&pdev->dev, "ASM1166 has only six ports\n");
+			hpriv->force_port_map = 0x3f;
+		} else if (pdev->device == 0x1064) {
+			dev_info(&pdev->dev, "ASM1064 has only four ports\n");
+			hpriv->force_port_map = 0xf;
+		}
+	}
+
 	if (pdev->vendor == PCI_VENDOR_ID_JMICRON && pdev->device == 0x2361) {
 		dev_info(&pdev->dev, "JMB361 has only one port\n");
 		hpriv->force_port_map = 1;
@@ -1755,6 +1766,12 @@ static int ahci_init_one(struct pci_dev *pdev, const struct pci_device_id *ent)
 	if (rc)
 		return rc;
 
+    /* 禁用ASPM（针对ASM1064） */
+/*     if (pdev->vendor == PCI_VENDOR_ID_ASMEDIA && pdev->device == 0x1064) {
+        pci_disable_link_state(pdev, PCIE_LINK_STATE_L0S | PCIE_LINK_STATE_L1);
+        dev_info(&pdev->dev, "ASPM disabled for ASM1064\n");
+    } */
+
 	if (pdev->vendor == PCI_VENDOR_ID_INTEL &&
 	    (pdev->device == 0x2652 || pdev->device == 0x2653)) {
 		u8 map;
@@ -1906,7 +1923,14 @@ static int ahci_init_one(struct pci_dev *pdev, const struct pci_device_id *ent)
 	 * determining the maximum port number requires looking at
 	 * both CAP.NP and port_map.
 	 */
-	n_ports = max(ahci_nr_ports(hpriv->cap), fls(hpriv->port_map));
+	/* 针对asm1064 限制4端口 */
+	//n_ports = max(ahci_nr_ports(hpriv->cap), fls(hpriv->port_map));
+
+	if (pdev->vendor == PCI_VENDOR_ID_ASMEDIA && pdev->device == 0x1064) {
+		n_ports = 4; /* ASM1064 has only four ports */
+	} else {
+		n_ports = max(ahci_nr_ports(hpriv->cap), fls(hpriv->port_map));
+	}
 
 	host = ata_host_alloc_pinfo(&pdev->dev, ppi, n_ports);
 	if (!host)
-- 
