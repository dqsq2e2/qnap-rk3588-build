+static int inc_tx(struct btusb_data *data)
+{
+    unsigned long flags;
+    int rv;
+
+    spin_lock_irqsave(&data->txlock, flags);
+    rv = test_bit(BTUSB_SUSPENDING, &data->flags);
+    if (!rv)
+        data->tx_in_flight++;
+    spin_unlock_irqrestore(&data->txlock, flags);
+
+    return rv;
+}
