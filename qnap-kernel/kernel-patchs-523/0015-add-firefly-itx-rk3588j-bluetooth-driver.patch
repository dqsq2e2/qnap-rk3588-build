+int aicbt_patch_table_free(struct aicbt_patch_table **head)
+{
+    struct aicbt_patch_table *p = *head, *n = NULL;
+    while (p) {
+        n = p->next;
+        kfree(p->name);
+        kfree(p->data);
+        kfree(p);
+        p = n;
+    }
+    *head = NULL;
+    return 0;
+}
