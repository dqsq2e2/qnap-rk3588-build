+#ifdef CONFIG_SUPPORT_VENDOR_APCF
+static int bypass_event(struct sk_buff *skb)
+{
+	int ret = 0;
+	u8 *opcode = (u8*)(skb->data);
+	//u8 len = *(opcode+1);
+	u16 sub_opcpde;
+
+	switch(*opcode) {
+		case HCI_EV_CMD_COMPLETE:
+			sub_opcpde = ((u16)opcode[3]|(u16)(opcode[4])<<8);
+			if(sub_opcpde == 0xfd57){
