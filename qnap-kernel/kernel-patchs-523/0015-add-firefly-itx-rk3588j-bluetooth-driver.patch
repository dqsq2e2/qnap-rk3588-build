+void util_hexdump(const u8 *buf, size_t len)
+{
+	static const char hexdigits[] = "0123456789abcdef";
+	char str[16 * 3];
+	size_t i;
+
+	if (!buf || !len)
+		return;
+
+	for (i = 0; i < len; i++) {
+		str[((i % 16) * 3)] = hexdigits[buf[i] >> 4];
+		str[((i % 16) * 3) + 1] = hexdigits[buf[i] & 0xf];
+		str[((i % 16) * 3) + 2] = ' ';
+		if ((i + 1) % 16 == 0) {
+			str[16 * 3 - 1] = '\0';
+			RTKBT_DBG("%s", str);
+		}
+	}
+
+	if (i % 16 > 0) {
+		str[(i % 16) * 3 - 1] = '\0';
+		RTKBT_DBG("%s", str);
+	}
+}
