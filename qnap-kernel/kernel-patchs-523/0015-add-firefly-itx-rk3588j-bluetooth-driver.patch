+        AICBT_ERR("Failed to register usb char device interfaces");
+    } else
+        bt_char_dev_registered = 1;
+#endif
+    err = usb_register(&btusb_driver);
+    if (err < 0)
+        AICBT_ERR("Failed to register aic bluetooth USB driver");
+    return err;
+}
