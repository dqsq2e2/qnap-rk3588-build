+static struct file_operations bt_chrdev_ops  = {
+    open    :    btchr_open,
+    release    :    btchr_close,
+    read    :    btchr_read,
+    write    :    btchr_write,
+    poll    :    btchr_poll,
+    unlocked_ioctl   :   btchr_ioctl,
+};
