 	unsigned long period;
 	int ret = 0;
 	struct pwm_state state = { };
+	pwm = clamp_val(pwm, MIN_PWM, MAX_PWM);
 
-	mutex_lock(&ctx->lock);
+	/* 锁管理完全由调用方控制 */
 	if (ctx->pwm_value == pwm)
 		goto exit_set_pwm_err;
 
@@ -88,7 +129,6 @@ static int  __set_pwm(struct pwm_fan_ctx *ctx, unsigned long pwm)
 	if (!ret)
 		ctx->pwm_value = pwm;
 exit_set_pwm_err:
-	mutex_unlock(&ctx->lock);
 	return ret;
 }
 
@@ -110,6 +150,9 @@ static ssize_t pwm_store(struct device *dev, struct device_attribute *attr,
 	unsigned long pwm;
 	int ret;
 
+    if (!ctx->user_control) // 非用户模式禁止写入
+        return -EPERM;
+
 	if (kstrtoul(buf, 10, &pwm) || pwm > MAX_PWM)
 		return -EINVAL;
 
@@ -117,6 +160,7 @@ static ssize_t pwm_store(struct device *dev, struct device_attribute *attr,
 	if (ret)
 		return ret;
 
+	ctx->user_pwm = pwm; // [MOD] 更新用户模式存储
 	pwm_fan_update_state(ctx, pwm);
 	return count;
 }
@@ -133,28 +177,122 @@ static ssize_t rpm_show(struct device *dev,
 			struct device_attribute *attr, char *buf)
 {
 	struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
-
+#ifdef CONFIG_PWM_FAN_SIMULATED_RPM
+	unsigned int simulated_rpm = (max_rpm * ctx->pwm_value) / MAX_PWM;
+	return sprintf(buf, "%u\n", simulated_rpm);
+#else
 	return sprintf(buf, "%u\n", ctx->rpm);
+#endif // CONFIG_PWM_FAN_SIMULATED_RPM
 }
 
 static SENSOR_DEVICE_ATTR_RW(pwm1, pwm, 0);
 static SENSOR_DEVICE_ATTR_RO(fan1_input, rpm, 0);
 
+//static int32_t fan_pwm1_enable = 1;
+static ssize_t show_pwm1_enable(struct device *dev,
+                struct device_attribute *attr,
+                char *buf)
+{
+    struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
+    return sprintf(buf, "%d\n", ctx->user_control ? 1 : 0);
+}
+
+/* 修改后的store_pwm1_enable函数 */
+static ssize_t store_pwm1_enable(struct device *dev,
+                 struct device_attribute *attr,
+                 const char *buf, size_t count)
+{
+    struct pwm_fan_ctx *ctx = dev_get_drvdata(dev);
+    int val, ret;
+    unsigned int target_pwm;
+    bool new_mode;
+
+    ret = kstrtoint(buf, 10, &val);
+    if (ret)
+        return ret;
+
+    new_mode = (val != 0);
+
+    mutex_lock(&ctx->lock);
+
+    if (ctx->user_control == new_mode)
+        goto unlock;
+
+    /* 内核5.10兼容方案 */
+    if (new_mode) {
+        /* 用户模式：保存当前thermal PWM值 */
+        ctx->thermal_pwm = ctx->pwm_fan_cooling_levels[ctx->pwm_fan_state];
+    } else {
+        /* Thermal模式：强制thermal子系统更新 */
+        if (ctx->cdev)
+            thermal_cdev_update(ctx->cdev);
+    }
+
+    ctx->user_control = new_mode;
+    target_pwm = new_mode ? ctx->user_pwm : ctx->thermal_pwm;
+    ret = __set_pwm(ctx, target_pwm);
+
+unlock:
+    mutex_unlock(&ctx->lock);
+    return ret ? : count;
+}
+
+
+static SENSOR_DEVICE_ATTR(pwm1_enable, 0644, show_pwm1_enable, store_pwm1_enable, 0);
+
+
+
+static ssize_t show_temp1_input(struct device *dev,
+                                struct device_attribute *attr,
+                                char *buf)
+{
+    struct thermal_zone_device *tz;
+    int temp, ret;
+
+    tz = thermal_zone_get_zone_by_name(thermal_zone);
+    if (IS_ERR(tz)) {
+        dev_err(dev, "Thermal zone '%s' not found\n", thermal_zone);
+        return sprintf(buf, "0\n");
+    }
+
+    ret = thermal_zone_get_temp(tz, &temp);
+    if (ret) {
+        dev_err(dev, "Failed to read temperature\n");
+        return sprintf(buf, "0\n");
+    }
+
+    return sprintf(buf, "%d\n", temp);
+}
+
+static ssize_t show_temp1_label(struct device *dev,
+                                struct device_attribute *attr,
+                                char *buf)
+{
+    return sprintf(buf, "SYSTIN\n");
+}
+
+static SENSOR_DEVICE_ATTR(temp1_input, 0644, show_temp1_input, NULL, 0);
+static SENSOR_DEVICE_ATTR(temp1_label, 0644, show_temp1_label, NULL, 0);
+
+
 static struct attribute *pwm_fan_attrs[] = {
 	&sensor_dev_attr_pwm1.dev_attr.attr,
 	&sensor_dev_attr_fan1_input.dev_attr.attr,
