+static void pwm_fan_cleanup(struct device *dev)
+{
+    // 移除 sysfs 组
+    sysfs_remove_group(&dev->kobj, &pwm_fan_group);
+
+    // 关闭 PWM 和电源（原有逻辑）
+    pwm_fan_disable(dev);
+}
+
+static int pwm_fan_remove(struct platform_device *pdev)
+{
+    pwm_fan_cleanup(&pdev->dev);
+    return 0;
+}
